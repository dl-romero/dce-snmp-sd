# ── snmp-http-sd Docker configuration ─────────────────────────────────────────
#
# Copy this file to .env and edit as needed.
# All values shown are the defaults.

# Host directory to mount as /data inside the container.
# Place module_lookup.json here before starting.
# devices.json (the persistent device inventory) is written here automatically.
DATA_DIR=./data

# Host directory containing snmp.yml for the snmp_exporter service.
# Defaults to DATA_DIR so you can keep all generated files in one place.
SNMP_CONFIG_DIR=./data

# Port to expose snmp-http-sd on the host.
PORT=8000

# How often to re-probe all devices for hostname changes (in hours).
REFRESH_INTERVAL_HOURS=6

# SNMP timeout per device in seconds.
SNMP_TIMEOUT=3

# SNMP retries per device.
SNMP_RETRIES=1
